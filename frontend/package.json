{
  "name": "lia-pos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../openapi.yaml -o src/lib/api-schema.ts",
