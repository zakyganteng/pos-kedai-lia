meta {
  name: Create Sale
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/sales?businessLineId={{kedaiLineId}}
  body: json
  auth: inherit
}

params:query {
  businessLineId: {{kedaiLineId}}
}

headers {
  X-Idempotency-Key: {{$guid}}
}

body:json {
  {
    "items": [
      {
        "itemType": "product",
        "itemId": "{{productId}}",
        "quantity": 2
      }
    ],
    "paymentMethod": "cash",
    "cashReceived": 50000
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("saleId", res.body.id);
    if (res.body.payment && res.body.payment.id) {
      bru.setEnvVar("paymentId", res.body.payment.id);
    }
  }
}
