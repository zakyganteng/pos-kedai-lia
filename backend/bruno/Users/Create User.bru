meta {
  name: Create User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Cashier Kedai",
    "email": "cashier-{{$guid}}@example.test",
    "password": "cashier-password-123",
    "role": "cashier",
    "businessLineIds": [
      "{{kedaiLineId}}"
    ]
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("userId", res.body.id);
  }
}
