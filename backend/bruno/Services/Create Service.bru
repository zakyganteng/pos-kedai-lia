meta {
  name: Create Service
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/services?businessLineId={{salonLineId}}
  body: json
  auth: inherit
}

params:query {
  businessLineId: {{salonLineId}}
}

body:json {
  {
    "name": "Wash & Blow Dry",
    "description": "Hair wash with vitamin and blow dry styling",
    "durationMinutes": 45,
    "price": 75000
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("serviceId", res.body.id);
  }
}
