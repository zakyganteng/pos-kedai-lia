meta {
  name: Create Staff
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/staff?businessLineId={{salonLineId}}
  body: json
  auth: inherit
}

params:query {
  businessLineId: {{salonLineId}}
}

body:json {
  {
    "name": "Rina Stylist"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("staffId", res.body.id);
  }
}
