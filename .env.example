# Optional overrides for compose.yaml; `make dev` works without a .env file.
# Copy to .env only if you need to change something.
APP_ENV=development
# Password of the `postgres` user, which the backend also uses. Keep it URL-safe.
# It is applied only when the database volume is first created.
POSTGRES_PASSWORD=postgres

# Host loopback ports (127.0.0.1 only). POS: http://localhost:3000
# API base URL: http://127.0.0.1:8080/api/v1
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=5432
SESSION_TTL=30m
# Business-day boundary for backend reports.
BUSINESS_TIMEZONE=Asia/Jakarta

# Disabled means unavailable, not successful. Use borderpay for real QRIS integration.
# Borderpay setup: docs/OPERATIONS.md#borderpay-qris
PAYMENT_PROVIDER=disabled
# Borderpay defaults to https://borderpay.id/api/v1 when empty.
PAYMENT_BASE_URL=
# Borderpay keys start with bp_test_ (sandbox) or bp_live_ (real money).
PAYMENT_API_KEY=
# Borderpay verification token from the project dashboard, at least 16 bytes.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROJECT_SLUG=
NOTIFICATION_PROVIDER=disabled
NOTIFICATION_BASE_URL=
NOTIFICATION_API_KEY=
NOTIFICATION_DESTINATION=
# Operational alert wording. Empty uses the backend default
# "Payment confirmed. Sale {{saleId}}, IDR {{total}}."
# Only {{saleId}}, {{total}} and {{businessLineId}} may be used, maximum 500 characters.
# A vendor-approved WhatsApp template remains a separate release dependency.
NOTIFICATION_TEMPLATE=

# Default login, created by the first migration: owner@owner.com / owner-password-123
# Production: APP_ENV=production; never use the mock provider.
